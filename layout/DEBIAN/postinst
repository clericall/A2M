#!/bin/sh
set -e

mkdir -p /var/mobile/Media/MusicDrop/inbox
mkdir -p /var/mobile/Media/MusicDrop/artwork
chown -R mobile:mobile /var/mobile/Media/MusicDrop
chmod 755 /var/mobile/Media/MusicDrop
chmod 755 /var/mobile/Media/MusicDrop/inbox
chmod 755 /var/mobile/Media/MusicDrop/artwork

# Relaunch Music so MobileSubstrate injects the tweak on next open.
KILLALL_BIN="$(command -v killall 2>/dev/null || true)"
if [ -z "$KILLALL_BIN" ] && [ -x /var/jb/usr/bin/killall ]; then
	KILLALL_BIN=/var/jb/usr/bin/killall
fi
if [ -n "$KILLALL_BIN" ]; then
	"$KILLALL_BIN" -9 Music 2>/dev/null || true
fi

exit 0
